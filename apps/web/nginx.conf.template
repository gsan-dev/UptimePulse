# nginx del frontend (Fase 5.4, self-hosted). La imagen oficial de nginx
# procesa este template con envsubst al arrancar (variables ${...}):
#   API_UPSTREAM  host:puerto de la API dentro de la red Docker (api:3000)
#   DNS_RESOLVER  resolver para re-resolver API_UPSTREAM (127.0.0.11 = DNS de Docker)
#
# Un solo origen para todo:
#   /            → la SPA (React Router: todo lo que no es un fichero va a index.html)
#   /api/...     → la API (se quita el prefijo: /api/monitors → /monitors)
#   /socket.io/  → WebSocket de la API (Socket.io)
# Así las imágenes publicadas sirven para cualquier dominio sin reconstruir
# y no hay CORS. Detrás va Caddy (TLS) u otro proxy que ponga X-Forwarded-*.
# Si nginx es el borde (sin Caddy delante) no llega X-Forwarded-Proto: se usa
# el esquema real de la conexión.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # El upstream va en una variable para que nginx lo re-resuelva (valid=10s)
    # en vez de fijar la IP al arrancar: si el contenedor de la API se
    # reinicia y cambia de IP, sin esto nginx devolvería 502 hasta reiniciarlo.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $api_upstream http://${API_UPSTREAM};

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # connect-src 'self' basta porque la API es mismo origen; ws:/wss: por el WebSocket.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'self'" always;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        # La API emite la cookie de refresh con Path=/auth; vista desde el
        # navegador esa ruta es /api/auth.
        proxy_cookie_path /auth /api/auth;
        proxy_read_timeout 75s;
    }

    location /socket.io/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
