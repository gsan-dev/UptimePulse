# Proxy TLS del self-hosted (perfil "tls" de docker-compose.prod.yml).
# Caddy obtiene y renueva solo el certificado de Let's Encrypt para DOMAIN
# (para "localhost" genera uno de su CA interna) y reenvía todo — SPA,
# /api y el WebSocket — al nginx del servicio "web".
{$DOMAIN} {
    encode gzip zstd
    reverse_proxy web:80
}
