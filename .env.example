# Copia este archivo a .env y ajusta los valores si hace falta.
# .env nunca se sube a git (ver .gitignore).
#
#   docker compose up    levanta TODO (web, API, worker, Postgres, Redis,
#                        Mailpit) y abre la web en http://localhost:WEB_PORT.
#
# Ninguna variable es obligatoria para eso: todas tienen valor por defecto en
# el docker-compose.yml. Este archivo es para cambiarlas.

# =========================================================================
# PUERTOS
# =========================================================================
# Cada variable manda a la vez en las tres cosas: el puerto publicado en tu
# máquina, el puerto en el que el servicio escucha dentro del contenedor y la
# URL con la que le hablan los demás servicios. Cambia el número aquí y ya
# está: no hay que tocar código, ni el compose, ni la configuración de nginx.

# La web — lo que abres en el navegador.
WEB_PORT=8080
# La API (REST + WebSocket). La web le habla por dentro de la red de Docker;
# se publica también para poder llamarla directamente o abrir /docs.
API_PORT=3000
# Servidor HTTP del worker: /health y /metrics (Fase 5.2).
WORKER_HTTP_PORT=3001
# Base de datos y cola.
POSTGRES_PORT=5432
REDIS_PORT=6379
# Mailpit: SMTP de pruebas y su bandeja de entrada web
# (http://localhost:MAILPIT_UI_PORT).
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Solo si entras a la web por algo que no es localhost (la IP de la máquina
# en la red local, un dominio…): los enlaces de los emails de invitación se
# construyen con esto. Vacío = http://localhost:WEB_PORT.
PUBLIC_URL=

# =========================================================================
# RESTO DE CONFIGURACIÓN
# =========================================================================

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=uptimepulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=uptimepulse

# Cadenas de conexión para cuando ejecutas la API/worker EN TU MÁQUINA
# (npm run dev:api / dev:worker) contra la infraestructura del compose. Dentro
# de Docker no se usan: allí el compose las construye solo, con el nombre del
# servicio en vez de localhost. Si cambias POSTGRES_PORT o REDIS_PORT arriba,
# cámbialos también aquí.
DATABASE_URL=postgres://uptimepulse:changeme@localhost:5432/uptimepulse
REDIS_URL=redis://localhost:6379

# --- API (Fase 1.1) ---
# Puerto de la API cuando la arrancas en tu máquina (dentro de Docker manda
# API_PORT). Déjalos iguales para no liarte.
PORT=3000
NODE_ENV=development

# Secretos para firmar los JWT. NUNCA reutilices estos valores de ejemplo.
# Genera los tuyos con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret

# Minutos de inactividad tras los que la sesión se cierra sola. Es la
# caducidad real del refresh token, que se renueva cada vez que se toca la
# interfaz: mientras se usa, la sesión se prorroga; en cuanto se deja de
# tocar, caduca. La cookie además no lleva Max-Age, así que cerrar el
# navegador también la borra.
SESSION_IDLE_TIMEOUT_MINUTES=15

# Solo para desarrollo local (Fase 1.2): desactiva la protección anti-SSRF
# para poder crear monitores contra hosts internos (localhost, tu red...).
# NUNCA lo pongas a "true" en un despliegue real.
ALLOW_PRIVATE_MONITOR_TARGETS=false

# --- Worker (Fase 2.1: cola BullMQ, sustituye el sondeo de la Fase 1.3) ---
# Cuántos checks puede ejecutar en paralelo CADA instancia del worker que
# arranques (no un total global — dos instancias con concurrency=5 dan 10
# checks en paralelo entre las dos).
WORKER_CONCURRENCY=5

# --- Motor de incidentes (Fase 2.2) ---
# Nº de checks "down" consecutivos antes de abrir un incidente real (y
# disparar la alerta). Con 1 se alertaría por cada bache puntual de red.
INCIDENT_FAILURE_THRESHOLD=2

# --- Email / alertas (Fase 1.5) ---
# Estos valores son para cuando ejecutas la app EN TU MÁQUINA: apuntan a
# Mailpit en localhost. Con `docker compose up` no se usan — allí el SMTP es
# el servicio "mailpit" de la propia red, en MAILPIT_SMTP_PORT. En producción
# (docker-compose.prod.yml) apunta a un proveedor real (Resend, SES…): el
# código no cambia, solo esta configuración.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UptimePulse <alerts@uptimepulse.local>"

# --- Enlaces en emails (Fase 4.1: invitaciones) ---
# URL pública del frontend cuando ejecutas la app EN TU MÁQUINA (el servidor
# de Vite). Con `docker compose up` manda PUBLIC_URL / WEB_PORT; en
# docker-compose.prod.yml manda esta.
APP_URL=http://localhost:5173

# --- Checks multi-región (Fase 4.2) ---
# Regiones desde las que se comprueba cada monitor, separadas por comas. Cada
# región es una cola propia y necesita al menos un proceso worker arrancado
# con WORKER_REGION=<región>. Un monitor se considera caído solo si lo ven
# caído la MAYORÍA de las regiones (quórum = floor(R/2)+1): con 2 regiones,
# las dos. Con una sola región (valor por defecto) todo funciona como antes.
CHECK_REGIONS=local
# Región de ESTE proceso worker (debe estar en CHECK_REGIONS). Para simular
# dos regiones en local: WORKER_REGION=eu-west npm run dev:worker  y
# WORKER_REGION=us-east npm run dev:worker  con CHECK_REGIONS=eu-west,us-east
WORKER_REGION=local

# --- Seguridad (Fase 5.1) ---
# Orígenes del frontend autorizados por CORS, separados por comas. Vacío =
# solo APP_URL. "*" solo se acepta fuera de producción.
CORS_ORIGINS=
# Peticiones por minuto y por IP (o por API key) para toda la API.
API_RATE_LIMIT_PER_MINUTE=300
# Intentos de login/registro por minuto y por IP.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Checks por minuto que puede recibir un mismo host de destino, sumando todos
# los monitores, usuarios y regiones (protege al destino, no a UptimePulse).
CHECK_MAX_PER_HOST_PER_MINUTE=60

# --- Self-hosting (docker-compose.prod.yml; ver docs/DEPLOY.md) ---
# Dominio para HTTPS automático con Caddy (perfil "tls"). Con él, APP_URL debe ser https://<DOMAIN>.
DOMAIN=
# Cookie de sesión solo por HTTPS. Pon false SOLO si accedes por HTTP plano
# (red local). Solo aplica a docker-compose.prod.yml: la pila local de
# `docker compose up` es HTTP y ya la pone en false por su cuenta.
COOKIE_SECURE=true
# Etiqueta de las imágenes de GHCR: latest o un SHA de commit para fijar versión.
UPTIMEPULSE_VERSION=latest

# --- Observabilidad (Fase 5.2) ---
# Si se define, /metrics (API y worker) exige "Authorization: Bearer <token>".
METRICS_TOKEN=
